# PlatformIO build products and local tooling state
.pio/
.pioenvs/
.piolibdeps/

# VS Code generated indexes (keep shareable workspace settings if added later)
.vscode/.browse.c_cpp.db*
.vscode/ipch/
.vscode/

# Logs and local secrets
*.log
.env
.env.*
!.env.example
!pc_bridge/.env.example
secrets.*
credentials.*
config/secrets.*

# Python cache generated by asset tools
__pycache__/
*.py[cod]

# OS metadata
.DS_Store
Thumbs.db

# PC bridge virtual environment and runtime artifacts
pc_bridge/.venv/
pc_bridge/.pytest_cache/
pc_bridge/.env
pc_bridge/captures/
pc_bridge/research_artifacts/
pc_bridge/research_data/

# Isolated Apple Music browser profile and CDP state
pc_bridge/apple-music-profile/
AppleMusicChrome/

# Third-party GPT-SoVITS runtime, virtual environment, and model weights
tools/GPT-SoVITS/
tools/gpt-sovits-runtime/

# Private voice recordings, generated speech, and model/cache data
voice/source/*
!voice/source/.gitkeep
voice/references/chris/*
!voice/references/chris/.gitkeep
voice/references/anchors/*
voice/generated/*
!voice/generated/.gitkeep
voice/cache/*
!voice/cache/.gitkeep
